  pastagoneArrested          Boolean   @default(false)
  pastagoneEscaped           Boolean   @default(false)
  pastagoneBossBeaten        Boolean   @default(false)
  pastagoneInterrogStart     DateTime?
  pastagoneInterrogDefis     Json      @default("{}")
  pastagoneOrphanChosen      String?
  pastagoneBolognionFound    Boolean   @default(false)
  pastagoneCuisinePuzzle     Json      @default("{}")
  pastagoneInfirmerieUses    Json      @default("{}")
  pastagoneTourLastNpc       String?
  pastagoneTourLastRotAt     DateTime?
  pastagoneTourCooldownUntil DateTime?
  // v4.0 — Extensions Pullman Pastagone (Inspecteur Coulter mini-boss + résistants)
  // pastagoneCoulterBeaten  : true après défaite de l'INSPECTEUR COULTER (mini-boss
  //                           Pastagone, sa Daemon orang-outan Dessingh).
  // pastagoneFaaGiftClaimed : true après que BRIGADIER FAA a donné son cadeau
  //                           (+100 reps one-shot, indice anti-boss).
  pastagoneCoulterBeaten     Boolean   @default(false)
  pastagoneFaaGiftClaimed    Boolean   @default(false)
  // v4.0 — CAPOLINO 3ᵉ + 4ᵉ rencontre :
  // pastagoneCapolinoMidBeaten : true après défaite du rival CAPOLINO en mid-arc Pastagone.
  // pastagoneCapolinoFleeShown : true après cinématique post-boss où CAPOLINO s'enfuit
  //                              en jurant vengeance (étape narrative one-shot).
  pastagoneCapolinoMidBeaten Boolean   @default(false)
  pastagoneCapolinoFleeShown Boolean   @default(false)

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([mapId])
  @@index([lastSeen(sort: Desc)])
}

// ════════════════════════════════════════════════════════════════════════════
// Nexus Jaune Éclair — ROULETTE EUROPÉENNE MULTIJOUEUR (Phase 4)
// ════════════════════════════════════════════════════════════════════════════
// Le SERVEUR est autoritatif sur (a) la MANCHE (timer de mise) et (b) le NUMÉRO
// GAGNANT (RNG seedé serveur, dérivé de l'id de manche → reproductible/auditable) :
// ainsi TOUT LE MONDE voit le MÊME résultat. Les MISES sont enregistrées pour
// l'affichage social (« voir les mises des autres ») et le calcul du net par joueur ;
// les montants sont DÉCLARÉS par le client (même modèle de confiance que le PvP yellow,
// chapitre créateur-gated). La CUSTODY de l'énergie reste CÔTÉ CLIENT (save
// GamebookProgress.flags) → ces 2 tables sont 100% ADDITIVES, zéro impact sur le save.
model RouletteRound {
  id            String        @id @default(cuid())
  // OPEN = mises ouvertes ; RESOLVED = numéro tiré, gains figés.
  status        String        @default("OPEN")
  startedAt     DateTime      @default(now())
  // Fin de la fenêtre de mise (startedAt + durée). Au-delà : résolution paresseuse au 1er poll.
  closesAt      DateTime
  resolvedAt    DateTime?
  winningNumber Int? // 0..36 (null tant que non tiré)
  winningColor  String? // "green" | "red" | "black"
  seed          Int? // seed serveur utilisé (audit / rejeu)
  bets          RouletteBet[]
  createdAt     DateTime      @default(now())

  @@index([status])
  @@index([closesAt])
}

model RouletteBet {
  id        String        @id @default(cuid())
  roundId   String
  round     RouletteRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  // userId/nickname en SCALAIRES (pas de relation → User non modifié, migration purement additive).
  userId    String
  nickname  String        @default("?")
  // Toutes les mises du joueur pour la manche, sérialisées : [{ type, numbers, chips, zoneId }].
  // Une seule ligne par (round, user) ; remplacée à chaque dépôt (le client envoie l'état complet).
  betsJson  String        @default("[]")
  staked    Int           @default(0) // somme des chips misés
  net       Int? // résultat net (gain - mise) une fois la manche résolue ; null avant
  luck      String? // jeton de chance SECRET (potion barman) : JSON {kind,cap} ; rig plafonné si SOLO
  // "Prêt à lancer" : le joueur a appuyé sur "Lancer la balle". Quand TOUS les parieurs sont prêts, la
  // manche se résout immédiatement (sans attendre la fenêtre de mise). Réinitialisé si la mise change.
  ready     Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([roundId, userId])
  @@index([roundId])
  @@index([userId])
}

// Table de poker Texas Hold'em PARTAGÉE du casino (multijoueur temps réel). Une ligne = une table (id fixe).
// Migration purement ADDITIVE (nouvelle table, aucun modèle existant modifié ; userId côté sièges = dans le JSON).
model PokerTable {
  id        String   @id // id fixe de la table (ex. "yellow_casino_holdem")
  // État moteur COMPLET sérialisé (sièges, DECK + cartes privées SERVEUR-ONLY, community, pot, phase…).
  // Jamais renvoyé brut au client : le serveur applique publicView() par joueur (anti-triche).
  stateJson String   @default("{}")
  // Verrou OPTIMISTE : incrémenté à chaque action → rejette une action concurrente périmée.
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
