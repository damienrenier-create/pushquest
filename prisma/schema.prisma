generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  isSystem  Boolean     @default(false)
  // v3.32 — Compte "tester" : se reset à chaque connexion (compte GUIGUI).
  // Implique isSystem=true mais désactive le bootstrap creator (pas de bypass des flags).
  isTester  Boolean     @default(false)
  // v4.1 — Compte INVITÉ/AMI : joue au Chapitre 2 (Nexus Jaune Éclair) mais EXCLU
  // du concours PushQuest (classements, flambeaux, badges, graphiques, amendes).
  isGuest   Boolean     @default(false)
  password  String
  nickname  String      @unique
  buyoutPaid Boolean    @default(false)
  buyoutPaidAt DateTime?
  featuredClaimsCount Int @default(0)
  sets      ExerciseSet[]
  fines     FineRecord[]
  sallyUps  MonthlyChallengeEntry[]
  badges    BadgeOwnership[]
  eventsFrom BadgeEvent[] @relation("EventFrom")
  eventsTo   BadgeEvent[] @relation("EventTo")
  eventLikes BadgeEventLike[]
  potEvents PotEvent[]
  wallMessages WallMessage[]
  advisorQuestions AdvisorQuestion[]
  gamebookProgress GamebookProgress[]
  statuses   UserStatus[]
  statusLikes StatusLike[]
  badgeLikes  BadgeLike[]
  medicalCertificates MedicalCertificate[]
  xpAdjustments XpAdjustment[]
  specialWorkoutEntries SpecialWorkoutEntry[]
  betsCreated            Bet[]            @relation("BetsCreated")
  betsTargeted           Bet[]            @relation("BetsTargeted")
  betEntries             BetEntry[]
  betEvents              BetEvent[]
  betEventLikesGiven     BetEventLike[]
  coinAdjustments        CoinAdjustment[]
  quotaModifiersGiven    QuotaModifier[]  @relation("QuotaModifierSource")
  quotaModifiersReceived QuotaModifier[]  @relation("QuotaModifierTarget")
  // v4.0 — Équipe de Daemons (refactor du tamagotchi single Json vers table 1-N).
  // L'ancien champ GamebookProgress.tamagotchi (Json) reste actif pendant la migration
  // pour assurer la coexistence (Phase 1.A-D). Cleanup en Phase 1.E uniquement.
  daemons                Daemon[]
  league    String      @default("POMPES")
  image     String?     // URL to profile picture
  alterEgoId String?     @unique
  alterEgo   User?       @relation("AlterEgo", fields: [alterEgoId], references: [id])
  originalProfile User?  @relation("AlterEgo")
  // PARRAINAGE (Nexus) : sponsorId = le parrain (qui a partagé son lien à l'inscription).
  //   gameMode = mode choisi à l'inscription ("normal" reps / "easy" 2×3000 / "debutant" 6×1000).
  sponsorId  String?
  sponsor    User?       @relation("Sponsorship", fields: [sponsorId], references: [id])
  sponsored  User[]      @relation("Sponsorship")
  gameMode   String      @default("normal")
  onboardingStartedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// Existing tables ...

// ============================================================
// v4.0 — Modèle Daemon (refactor du tamagotchi Json vers table 1-N)
// ============================================================
// Chaque user peut avoir jusqu'à 6 daemons (slot 1-6). Le leader est slot 1.
// L'animal d'origine de PastaVegas (anciennement tamagotchi) devient le Daemon
// du joueur en slot 1. Les daemons supplémentaires viennent du boss Pastagone
// (3 animaux orphelins) et de Bolognion (énigme cuisine).
//
// Stats de combat (Pokémon Gen 1) :
//   - F (Force) / V (Vitesse) / D (Défense) / I (Intelligence) / E (Endurance)
//   - Bonheur (Happiness) : multiplicateur global ×0.5 à ×1.5
//   - HP combat dérivé d'Endurance + combatLevel
//
// Tracking Saiyan (pour calcul des 5-9 points par level up) :
//   - energySpentThisLevel : énergie dépensée en attaques depuis le dernier level up
//   - koCountThisLevel : nb de K.O. subis depuis le dernier level up
//   - easyBattlesCount / hardBattlesCount : combats faciles (< -3 level) vs durs (> +3 level)
//
// Attaques :
//   - attacksKnown : array de codes d'attaques apprises (Json)
//   - attacksEquipped : array de 4 max (slots de moveset) (Json)
//   - equippedItems : items équipés (collier, muselière, etc.) (Json)
// ============================================================
model Daemon {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotIndex       Int      // 1..6 (1 = leader)
  name            String
  // Identité (héritée XP_ANIMALS pour le sprite/emoji affiché)
  speciesLevel    Int      // 1..100, mappé sur XP_ANIMALS
  // Type Pokémon (combat) — Normal au départ, évolution via pierres dans arc post-Pastagone
  type            String   @default("Normal")  // Normal | Feu | Eau | Plante | Electrique | Vol | Psy | Pate | Combat | Roche
  // Morphologie (pour variantes d'attaques)
  morphology      String   @default("pattes")  // crocs | bec | insecte | pattes | ecailles
  // Progression combat (Saiyan)
  combatLevel     Int      @default(1)
  combatXp        Int      @default(0)
  // Stats de base (héritées des datas réelles du joueur, clamp 25-100)
  baseFor         Int      @default(25)
  baseVit         Int      @default(25)
  baseDef         Int      @default(25)
  baseInt         Int      @default(25)
  baseEnd         Int      @default(25)
  // Bonus alloués par level-ups (répartition manuelle, clamp 0-80)
  bonusFor        Int      @default(0)
  bonusVit        Int      @default(0)
  bonusDef        Int      @default(0)
  bonusInt        Int      @default(0)
  bonusEnd        Int      @default(0)
  // État live
  currentHp       Int      @default(100)
  happiness       Int      @default(50)
  // Tracking Saiyan (reset à 0 à chaque level up)
  energySpentThisLevel  Int @default(0)
  koCountThisLevel      Int @default(0)
  // Tracking meta (cumulé sur la vie de l'animal)
  easyBattlesCount      Int @default(0)
  hardBattlesCount      Int @default(0)
  battlesTotal          Int @default(0)
  damageReceivedTotal   Int @default(0)
  // Attaques (Json arrays)
  attacksKnown    Json     @default("[\"charge\"]")
  attacksEquipped Json     @default("[\"charge\"]")
  // Items équipés (Json array de string keys)
  equippedItems   Json     @default("[]")
  // Méta narratif
  recovered       Boolean  @default(false)  // a passé les 7 défis d'adoption (animal #1 uniquement, autres = true direct)
  inBag           Boolean  @default(false)
  // Lien d'origine narratif : "pastavegas" (animal #1), "pastagone_boss_volt/vol/psy", "pastagone_bolognion"
  origin          String   @default("pastavegas")
  // Sérum gate (v4.0 Phase 1.D.bis) :
  //   null  = compagnon 🐾 ANIMAL (stats/type/combat masqués côté UI)
  //   set   = 👾 DAEMON déverrouillé après usage du Sérum de Poussière
  //           (drop du chef mafia Team Boulette, pré-Pastagone)
  unlockedAt      DateTime?
  // Saiyan level up (v4.0 Phase 3) :
  //   points en attente de répartition manuelle entre les 5 stats (F/V/D/I/E).
  //   Crédités automatiquement au level up combat (5-9 points par level selon
  //   effort = energySpentThisLevel + résilience = koCountThisLevel + difficulté).
  //   Le joueur dépense via POST /api/gamebook/daemon/allocate-points.
  pendingStatPoints Int @default(0)
  // Timestamps
  lastFedAt       DateTime?
  lastKoAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, slotIndex])
  @@index([userId])
}

model GlobalConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ExerciseSet {
  id        String   @id @default(cuid())
  reps      Int
  exercise  String   // "PUSHUP", "PULLUP", "SQUAT"
  date      String   // YYYY-MM-DD
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cadeau de reps : si non-null, ces reps sont OFFERTES à ce joueur.
  // Elles comptent dans le volume/XP du donneur (userId) mais PAS son quota,
  // et remplissent le quota du bénéficiaire (offeredToUserId). Voir src/lib/quota.ts.
  offeredToUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([date, exercise])
  @@index([offeredToUserId, date])
}

model FineRecord {
  id        String   @id @default(cuid())
  amountEur Int      @default(2)
  date      String   // YYYY-MM-DD
  status    String   @default("unpaid") // "unpaid", "paid"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  paidAt    DateTime?

  @@unique([userId, date])
}

model MonthlyChallengeEntry {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD (Last day of month)
  type      String   @default("SALLY_UP")
  seconds   Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date, type])
}

model MedicalCertificate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDateISO    String
  endDateISO      String
  createdAt       DateTime @default(now())
  createdMonthKey String   // YYYY-MM (unique per user/month)
  note            String?

  @@unique([userId, createdMonthKey])
}

model PotEvent {
  id        String   @id @default(cuid())
  type      String   // "BUYOUT"
  amountEur Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())
}

model BadgeDefinition {
  key           String   @id
  name          String
  description   String
  isUnique      Boolean  @default(false)
  isTransferable Boolean @default(true)
  metricType    String   // "MAX_REPS", "BONUS_STREAK", "SERIES_COUNT", etc.
  exerciseScope String   // "PUSHUPS", "PULLUPS", "SQUATS", "ALL"
  threshold     Int?
  seriesTarget  Int?
  emoji         String   @default("🏅")
  ownership     BadgeOwnership?
  events        BadgeEvent[]
}

model BadgeOwnership {
  badgeKey      String   @id
  badge         BadgeDefinition @relation(fields: [badgeKey], references: [key], onDelete: Cascade)
  currentUserId String?
  currentUser   User?    @relation(fields: [currentUserId], references: [id], onDelete: SetNull)
  currentValue  Float    @default(0)
  achievedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  locked        Boolean  @default(false)
  likes         BadgeLike[]
}

model BadgeLike {
  id        String   @id @default(cuid())
  badgeKey  String
  badge     BadgeOwnership @relation(fields: [badgeKey], references: [badgeKey], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([badgeKey, userId])
}

model BadgeEvent {
  id            String   @id @default(cuid())
  badgeKey      String
  badge         BadgeDefinition @relation(fields: [badgeKey], references: [key], onDelete: Cascade)
  fromUserId    String?
  fromUser      User?    @relation("EventFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId      String?
  toUser        User?    @relation("EventTo", fields: [toUserId], references: [id], onDelete: SetNull)
  eventType     String   // "CLAIM", "STEAL", "UNIQUE_AWARDED"
  previousValue Float?
  newValue      Float?
  metadata      String?  // JSON string for additional info
  likes         BadgeEventLike[]
  createdAt     DateTime @default(now())
}

model BadgeEventLike {
  id        String   @id @default(cuid())
  eventId   String
  event     BadgeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model WallMessage {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Nexus Jaune Éclair — questions posées au CONSEILLER (PNJ à côté du Centre Daemon).
// Le joueur pose une question en jeu → stockée ici. Le créateur (Sartay) la lit et y
// répond en renseignant `answer` directement en base ; la réponse réapparaît au joueur
// dans le panneau du conseiller. Modèle ADDITIF (aucune table existante modifiée).
model AdvisorQuestion {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Nexus Jaune — CADEAU CROISÉ de duel : quand un joueur bat le reflet d'un autre, ce dernier
// reçoit une consolation (énergie + rêve du Dieu Spaghetti) à sa PROCHAINE connexion.
// Pas de @relation (champs userId en String) pour ne pas modifier le modèle User.
model DuelGift {
  id           String   @id @default(cuid())
  toUserId     String   // joueur mirouté qui reçoit la consolation
  fromUserId   String   // vainqueur (anti-stacking + traçabilité)
  fromNickname String   // pseudo du vainqueur (pour le rêve du Dieu Spaghetti)
  energy       Int      @default(30)
  claimed      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([toUserId, claimed])
}

// LIGUE — HALL OF FAME partagé : une ligne par sacre de Champion (victoire sur LE MAÎTRE).
// L'équipe est figée au sacre (JSON : ChampionMon[] = sprite/niveau/stats/moves). Consultable
// par TOUS les joueurs depuis le menu START. Pas de @relation (userId String) → User intact.
model LeagueChampion {
  id        String   @id @default(cuid())
  userId    String   // vainqueur
  nickname  String   // pseudo trusté serveur (affiché au Hall of Fame)
  team      String   // JSON ChampionMon[] (équipe sacrée, gelée)
  world     String   @default("live") // run du sacre : "live" (run 1) | "ngplus" (run 2) | "run3" — HoF Ligue par run
  wonAt     DateTime @default(now())

  @@index([wonAt])
  @@index([userId])
}

// LEADERBOARD des scores de RUN (concours) — partagé, visible des joueurs ayant fini le run 1 (>=5 badges).
//   run2 = énergie en réserve au re-sacre NG+ ; run3 = Σ des niveaux ennemis vaincus (concours).
//   Unités différentes → 2 classements distincts. 1 ligne par (userId, run) au mieux (run one-shot).
model YellowRunScore {
  id        String   @id @default(cuid())
  userId    String
  nickname  String   // pseudo trusté serveur
  run       String   // "run2" | "run3"
  score     Int
  factors   Json?    // RUN 2 : détail des 5 axes (ScoreFactor[]) pour un affichage consultable partout. null = run 3 / ancien score. ADDITIF (db:push).
  wonAt     DateTime @default(now())

  @@index([run, score])
  @@index([userId, run])
}

// ARÈNES — HALL OF FAME PAR GYM : à chaque conquête d'un badge (boss d'arène battu), on grave
// l'équipe victorieuse pour cette arène. Calqué sur LeagueChampion (+ badgeId). Pas de @relation
// (userId String) → User intact. 100% ADDITIF (db:push). Pattern gaté côté code (prisma as any).
model ArenaChampion {
  id        String   @id @default(cuid())
  userId    String   // vainqueur
  nickname  String   // pseudo trusté serveur
  badgeId   String   // "feu" | "plante" | "eau" | "roche" | "elec" (l'arène conquise)
  team      String   // JSON ChampionMon[] (équipe gelée au moment de la victoire)
  wonAt     DateTime @default(now())

  @@index([badgeId, wonAt])
  @@index([userId, badgeId])
}

// LIGUE — RÉCOMPENSE CROISÉE : à chaque sacre, TOUS les autres joueurs gagnent 1/3 de leur quota
// énergétique. Une ligne par bénéficiaire ; le montant (1/3 du repsCap) est calculé CÔTÉ CLIENT au
// moment de réclamer (le serveur ne connaît pas le cap de chacun). Pas de @relation.
model LeagueEnergyGrant {
  id           String   @id @default(cuid())
  toUserId     String   // bénéficiaire (tout joueur sauf le nouveau champion)
  fromUserId   String   // nouveau champion (anti-stacking)
  fromNickname String   // pseudo du champion (notif au bénéficiaire)
  claimed      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([toUserId, claimed])
}

// SHINY — FÊTE COMMUNAUTAIRE : quand un joueur CROISE un shiny, tous les joueurs reçoivent +50 énergie
// (le Dieu Spaghetti l'annonce) ; quand un shiny est CAPTURÉ, +50 de plus pour tous. Un don par
// bénéficiaire, réclamé au login (hors-plafond). eventKey (kind:uid) = idempotence anti-doublon.
// Pas de @relation (userId String). Additif (db:push). Pattern gaté côté code.
model ShinyGift {
  id           String   @id @default(cuid())
  toUserId     String   // bénéficiaire (TOUS les joueurs yellow)
  fromUserId   String   // joueur qui a croisé / capturé le shiny
  fromNickname String   // pseudo (annonce du Dieu Spaghetti)
  kind         String   // "encounter" | "captured"
  speciesId    String   // le shiny concerné (annonce)
  eventKey     String   // "encounter:<uid>" / "captured:<uid>" → idempotence (1 fête par événement)
  energy       Int      @default(50)
  claimed      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([toUserId, claimed])
  @@index([eventKey])
}

// PARRAINAGE — BONUS MUTUELS parrain↔filleul (calqué sur ShinyGift/LeagueEnergyGrant). Quand un pote
// (parrain OU filleul) accomplit un exploit, l'autre reçoit un don d'énergie réclamé au login :
//   kind="arena"  → +1/10 de la jauge run 1 du bénéficiaire (montant CALCULÉ au claim, energy=0 ici).
//   kind="shiny"  → +500⚡ (×10 de la fête communautaire) quand un pote CAPTURE un shiny.
// Une ligne par bénéficiaire. Pas de @relation (userId String). Additif (db:push). Pattern gaté côté code.
model SponsorGift {
  id           String   @id @default(cuid())
  toUserId     String   // parrain ou filleul bénéficiaire
  fromUserId   String   // le pote qui a déclenché l'exploit (traçabilité)
  fromNickname String   // pseudo (annonce du Dieu Spaghetti)
  kind         String   // "arena" | "shiny"
  energy       Int      @default(0) // shiny = 500 (fixe) ; arena = 0 → 1/10 du repsCap calculé au claim
  detail       String?  // badge conquis / speciesId du shiny (pour l'annonce)
  claimed      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([toUserId, claimed])
}

// ZONE DE COMBAT (Battle Frontier) — profil persistant par joueur : solde de Jetons de Combat (JC),
// meilleurs records de série par salle, symboles obtenus. Sert aussi de base aux leaderboards.
// Pas de @relation (userId String @unique) → User intact. Additif (db:push). Pattern gaté côté code.
model FrontierProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  jc          Int      @default(0)    // solde de Jetons de Combat
  towerBest   Int      @default(0)    // meilleure série Tour
  factoryBest Int      @default(0)    // meilleure série Usine
  domeBest    Int      @default(0)    // meilleur résultat Dôme (rounds gagnés)
  symbols     Json     @default("[]") // symboles de prestige obtenus (cosmétique)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserStatus {
  id        String   @id @default(cuid())
  content   String
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  likes     StatusLike[]
}

model StatusLike {
  id        String   @id @default(cuid())
  statusId  String
  status    UserStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([statusId, userId])
}


model XpAdjustment {
  id        String   @id @default(cuid())
  amount    Int
  reason    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([userId])
}

model SpecialWorkoutEntry {
  id              String   @id @default(cuid())
  workoutId       String   // ID from specialWorkouts.ts
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data            Json     // { exercises: { burpees: 50, run_m: 1000 }, time_sec: 450 }
  totalScore      Float?   // Calculated score for ranking if needed
  completionTime  Int?     // Seconds
  proofUrl        String?  // Optional link to photo/video proof
  date            String   // YYYY-MM-DD
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, workoutId])
  @@index([workoutId, totalScore])
}

// ─── SYSTÈME DE PARIS ────────────────────────────────────────────────────────────────────

model Bet {
  id               String      @id @default(cuid())
  type             String      // "PRONOSTIC" | "DUEL" | "COURSE"
  subType          String      @default("BINARY") // "BINARY" | "MULTI" | "NUMERIC" | "PLAYER_RACE"
  title            String
  description      String?
  options          String      // JSON : [{ key: string, label: string, emoji?: string }]
  status           String      @default("DRAFT") // "DRAFT" | "OPEN" | "LOCKED" | "RESOLVED" | "CANCELLED"
  openAt           DateTime?
  closeAt          DateTime?
  lockAt           DateTime?
  resolvedAt       DateTime?
  resolvedOption   String?
  resolvedByUserId String?
  createdByUserId  String
  createdBy        User        @relation("BetsCreated", fields: [createdByUserId], references: [id])
  targetUserId     String?
  targetUser       User?       @relation("BetsTargeted", fields: [targetUserId], references: [id])
  metadata         String?     // JSON extensible
  entries          BetEntry[]
  events           BetEvent[]
  result           BetResult?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([closeAt])
}

model BetEntry {
  id          String    @id @default(cuid())
  betId       String
  bet         Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  option      String
  xpStaked    Int
  multiplier  Float
  lockedOdd   Float?    // cote bookmaker figée au moment de la mise (null si pas de config stats)
  ecStaked    Int       @default(0)
  withdrawn   Boolean   @default(false)
  withdrawnAt DateTime?
  xpReturned  Int?
  ecReturned  Int?
  placedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([betId, userId])
  @@index([betId])
  @@index([userId])
}

model BetEvent {
  id         String         @id @default(cuid())
  betId      String
  bet        Bet            @relation(fields: [betId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  String         // "STAKE" | "INCREASE" | "WITHDRAW" | "RESOLVE" | "CANCEL" | "DUEL_SENT" | "DUEL_ACCEPTED" | "DUEL_DECLINED"
  xpAmount   Int            @default(0)
  ecAmount   Int            @default(0)
  option     String?
  multiplier Float?
  metadata   String?
  likes      BetEventLike[]
  createdAt  DateTime       @default(now())

  @@index([betId])
  @@index([userId])
  @@index([createdAt])
}

model BetEventLike {
  id        String   @id @default(cuid())
  eventId   String
  event     BetEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model BetResult {
  id                   String   @id @default(cuid())
  betId                String   @unique
  bet                  Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)
  winnerOption         String?
  resolvedAt           DateTime @default(now())
  resolvedByUserId     String
  distributionSnapshot String?  // JSON snapshot des gains distribués
  note                 String?
}

// ─── ÉCONOMIE EMBERCOINS ───────────────────────────────────────────────────────────────────

model CoinAdjustment {
  id        String   @id @default(cuid())
  amount    Int      // positif = gain, négatif = dépense
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String   // "BET_WIN" | "BET_STAKE" | "BET_WITHDRAW" | "BET_CANCELLED" | "BET_DECLINED" | "BADGE_REWARD" | "QUOTA_MODIFIER" | "SPECIAL_ACTION"
  refId     String?  // betId, badgeKey, etc.
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
}

// ─── MODIFICATEURS DE QUOTA ────────────────────────────────────────────────────────────────

model QuotaModifier {
  id               String   @id @default(cuid())
  type             String   // "REDUCE_SELF" | "INCREASE_OTHER"
  sourceUserId     String
  sourceUser       User     @relation("QuotaModifierSource", fields: [sourceUserId], references: [id])
  targetUserId     String
  targetUser       User     @relation("QuotaModifierTarget", fields: [targetUserId], references: [id])
  targetDateISO    String   // YYYY-MM-DD — jamais le jour de la dépense
  repsDelta        Int      // négatif pour REDUCE_SELF, positif pour INCREASE_OTHER
  ecCost           Int
  baseEcPerRep     Int      @default(10)
  demandMultiplier Float    @default(1.0)
  status           String   @default("PENDING") // "PENDING" | "APPLIED" | "CANCELLED"
  createdAt        DateTime @default(now())
  appliedAt        DateTime?

  @@index([targetUserId, targetDateISO])
  @@index([sourceUserId])
  @@index([targetDateISO, status])
}

