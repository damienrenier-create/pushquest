generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  isSystem  Boolean     @default(false)
  password  String
  nickname  String      @unique
  buyoutPaid Boolean    @default(false)
  buyoutPaidAt DateTime?
  featuredClaimsCount Int @default(0)
  sets      ExerciseSet[]
  fines     FineRecord[]
  sallyUps  MonthlyChallengeEntry[]
  badges    BadgeOwnership[]
  eventsFrom BadgeEvent[] @relation("EventFrom")
  eventsTo   BadgeEvent[] @relation("EventTo")
  eventLikes BadgeEventLike[]
  potEvents PotEvent[]
  wallMessages WallMessage[]
  gamebookProgress GamebookProgress[]
  statuses   UserStatus[]
  statusLikes StatusLike[]
  badgeLikes  BadgeLike[]
  medicalCertificates MedicalCertificate[]
  xpAdjustments XpAdjustment[]
  specialWorkoutEntries SpecialWorkoutEntry[]
  betsCreated            Bet[]            @relation("BetsCreated")
  betsTargeted           Bet[]            @relation("BetsTargeted")
  betEntries             BetEntry[]
  betEvents              BetEvent[]
  betEventLikesGiven     BetEventLike[]
  coinAdjustments        CoinAdjustment[]
  quotaModifiersGiven    QuotaModifier[]  @relation("QuotaModifierSource")
  quotaModifiersReceived QuotaModifier[]  @relation("QuotaModifierTarget")
  league    String      @default("POMPES")
  image     String?     // URL to profile picture
  alterEgoId String?     @unique
  alterEgo   User?       @relation("AlterEgo", fields: [alterEgoId], references: [id])
  originalProfile User?  @relation("AlterEgo")
  onboardingStartedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// Existing tables ...

model GlobalConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ExerciseSet {
  id        String   @id @default(cuid())
  reps      Int
  exercise  String   // "PUSHUP", "PULLUP", "SQUAT"
  date      String   // YYYY-MM-DD
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([date, exercise])
}

model FineRecord {
  id        String   @id @default(cuid())
  amountEur Int      @default(2)
  date      String   // YYYY-MM-DD
  status    String   @default("unpaid") // "unpaid", "paid"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  paidAt    DateTime?

  @@unique([userId, date])
}

model MonthlyChallengeEntry {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD (Last day of month)
  type      String   @default("SALLY_UP")
  seconds   Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date, type])
}

model MedicalCertificate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDateISO    String
  endDateISO      String
  createdAt       DateTime @default(now())
  createdMonthKey String   // YYYY-MM (unique per user/month)
  note            String?

  @@unique([userId, createdMonthKey])
}

model PotEvent {
  id        String   @id @default(cuid())
  type      String   // "BUYOUT"
  amountEur Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())
}

model BadgeDefinition {
  key           String   @id
  name          String
  description   String
  isUnique      Boolean  @default(false)
  isTransferable Boolean @default(true)
  metricType    String   // "MAX_REPS", "BONUS_STREAK", "SERIES_COUNT", etc.
  exerciseScope String   // "PUSHUPS", "PULLUPS", "SQUATS", "ALL"
  threshold     Int?
  seriesTarget  Int?
  emoji         String   @default("🏅")
  ownership     BadgeOwnership?
  events        BadgeEvent[]
}

model BadgeOwnership {
  badgeKey      String   @id
  badge         BadgeDefinition @relation(fields: [badgeKey], references: [key], onDelete: Cascade)
  currentUserId String?
  currentUser   User?    @relation(fields: [currentUserId], references: [id], onDelete: SetNull)
  currentValue  Float    @default(0)
  achievedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  locked        Boolean  @default(false)
  likes         BadgeLike[]
}

model BadgeLike {
  id        String   @id @default(cuid())
  badgeKey  String
  badge     BadgeOwnership @relation(fields: [badgeKey], references: [badgeKey], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([badgeKey, userId])
}

model BadgeEvent {
  id            String   @id @default(cuid())
  badgeKey      String
  badge         BadgeDefinition @relation(fields: [badgeKey], references: [key], onDelete: Cascade)
  fromUserId    String?
  fromUser      User?    @relation("EventFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId      String?
  toUser        User?    @relation("EventTo", fields: [toUserId], references: [id], onDelete: SetNull)
  eventType     String   // "CLAIM", "STEAL", "UNIQUE_AWARDED"
  previousValue Float?
  newValue      Float?
  metadata      String?  // JSON string for additional info
  likes         BadgeEventLike[]
  createdAt     DateTime @default(now())
}

model BadgeEventLike {
  id        String   @id @default(cuid())
  eventId   String
  event     BadgeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model WallMessage {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model UserStatus {
  id        String   @id @default(cuid())
  content   String
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  likes     StatusLike[]
}

model StatusLike {
  id        String   @id @default(cuid())
  statusId  String
  status    UserStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([statusId, userId])
}


model XpAdjustment {
  id        String   @id @default(cuid())
  amount    Int
  reason    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([userId])
}

model SpecialWorkoutEntry {
  id              String   @id @default(cuid())
  workoutId       String   // ID from specialWorkouts.ts
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data            Json     // { exercises: { burpees: 50, run_m: 1000 }, time_sec: 450 }
  totalScore      Float?   // Calculated score for ranking if needed
  completionTime  Int?     // Seconds
  proofUrl        String?  // Optional link to photo/video proof
  date            String   // YYYY-MM-DD
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, workoutId])
  @@index([workoutId, totalScore])
}

// ─── SYSTÈME DE PARIS ────────────────────────────────────────────────────────────────────

model Bet {
  id               String      @id @default(cuid())
  type             String      // "PRONOSTIC" | "DUEL" | "COURSE"
  subType          String      @default("BINARY") // "BINARY" | "MULTI" | "NUMERIC" | "PLAYER_RACE"
  title            String
  description      String?
  options          String      // JSON : [{ key: string, label: string, emoji?: string }]
  status           String      @default("DRAFT") // "DRAFT" | "OPEN" | "LOCKED" | "RESOLVED" | "CANCELLED"
  openAt           DateTime?
  closeAt          DateTime?
  lockAt           DateTime?
  resolvedAt       DateTime?
  resolvedOption   String?
  resolvedByUserId String?
  createdByUserId  String
  createdBy        User        @relation("BetsCreated", fields: [createdByUserId], references: [id])
  targetUserId     String?
  targetUser       User?       @relation("BetsTargeted", fields: [targetUserId], references: [id])
  metadata         String?     // JSON extensible
  entries          BetEntry[]
  events           BetEvent[]
  result           BetResult?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([closeAt])
}

model BetEntry {
  id          String    @id @default(cuid())
  betId       String
  bet         Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  option      String
  xpStaked    Int
  multiplier  Float
  lockedOdd   Float?    // cote bookmaker figée au moment de la mise (null si pas de config stats)
  ecStaked    Int       @default(0)
  withdrawn   Boolean   @default(false)
  withdrawnAt DateTime?
  xpReturned  Int?
  ecReturned  Int?
  placedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([betId, userId])
  @@index([betId])
  @@index([userId])
}

model BetEvent {
  id         String         @id @default(cuid())
  betId      String
  bet        Bet            @relation(fields: [betId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  String         // "STAKE" | "INCREASE" | "WITHDRAW" | "RESOLVE" | "CANCEL" | "DUEL_SENT" | "DUEL_ACCEPTED" | "DUEL_DECLINED"
  xpAmount   Int            @default(0)
  ecAmount   Int            @default(0)
  option     String?
  multiplier Float?
  metadata   String?
  likes      BetEventLike[]
  createdAt  DateTime       @default(now())

  @@index([betId])
  @@index([userId])
  @@index([createdAt])
}

model BetEventLike {
  id        String   @id @default(cuid())
  eventId   String
  event     BetEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model BetResult {
  id                   String   @id @default(cuid())
  betId                String   @unique
  bet                  Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)
  winnerOption         String?
  resolvedAt           DateTime @default(now())
  resolvedByUserId     String
  distributionSnapshot String?  // JSON snapshot des gains distribués
  note                 String?
}

// ─── ÉCONOMIE EMBERCOINS ───────────────────────────────────────────────────────────────────

model CoinAdjustment {
  id        String   @id @default(cuid())
  amount    Int      // positif = gain, négatif = dépense
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String   // "BET_WIN" | "BET_STAKE" | "BET_WITHDRAW" | "BET_CANCELLED" | "BET_DECLINED" | "BADGE_REWARD" | "QUOTA_MODIFIER" | "SPECIAL_ACTION"
  refId     String?  // betId, badgeKey, etc.
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
}

// ─── MODIFICATEURS DE QUOTA ────────────────────────────────────────────────────────────────

model QuotaModifier {
  id               String   @id @default(cuid())
  type             String   // "REDUCE_SELF" | "INCREASE_OTHER"
  sourceUserId     String
  sourceUser       User     @relation("QuotaModifierSource", fields: [sourceUserId], references: [id])
  targetUserId     String
  targetUser       User     @relation("QuotaModifierTarget", fields: [targetUserId], references: [id])
  targetDateISO    String   // YYYY-MM-DD — jamais le jour de la dépense
  repsDelta        Int      // négatif pour REDUCE_SELF, positif pour INCREASE_OTHER
  ecCost           Int
  baseEcPerRep     Int      @default(10)
  demandMultiplier Float    @default(1.0)
  status           String   @default("PENDING") // "PENDING" | "APPLIED" | "CANCELLED"
  createdAt        DateTime @default(now())
  appliedAt        DateTime?

  @@index([targetUserId, targetDateISO])
  @@index([sourceUserId])
  @@index([targetDateISO, status])
}

model GamebookProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId     String
  currentNodeId String
  mood          String   @default("NEUTRE")
  mbtiScores    Json     @default("{}")
  temperaments  Json     @default("{}")
  flags         Json     @default("{}")
  history       Json     @default("[]")
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
}
