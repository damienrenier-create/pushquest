generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  isSystem  Boolean     @default(false)
  // v3.32 — Compte "tester" : se reset à chaque connexion (compte GUIGUI).
  // Implique isSystem=true mais désactive le bootstrap creator (pas de bypass des flags).
  isTester  Boolean     @default(false)
  password  String
  nickname  String      @unique
  buyoutPaid Boolean    @default(false)
  buyoutPaidAt DateTime?
  featuredClaimsCount Int @default(0)
  sets      ExerciseSet[]
  fines     FineRecord[]
  sallyUps  MonthlyChallengeEntry[]
  badges    BadgeOwnership[]
  eventsFrom BadgeEvent[] @relation("EventFrom")
  eventsTo   BadgeEvent[] @relation("EventTo")
  eventLikes BadgeEventLike[]
  potEvents PotEvent[]
  wallMessages WallMessage[]
  gamebookProgress GamebookProgress[]
  statuses   UserStatus[]
  statusLikes StatusLike[]
  badgeLikes  BadgeLike[]
  medicalCertificates MedicalCertificate[]
  xpAdjustments XpAdjustment[]
  specialWorkoutEntries SpecialWorkoutEntry[]
  betsCreated            Bet[]            @relation("BetsCreated")
  betsTargeted           Bet[]            @relation("BetsTargeted")
  betEntries             BetEntry[]
  betEvents              BetEvent[]
  betEventLikesGiven     BetEventLike[]
  coinAdjustments        CoinAdjustment[]
  quotaModifiersGiven    QuotaModifier[]  @relation("QuotaModifierSource")
  quotaModifiersReceived QuotaModifier[]  @relation("QuotaModifierTarget")
  league    String      @default("POMPES")
  image     String?     // URL to profile picture
  alterEgoId String?     @unique
  alterEgo   User?       @relation("AlterEgo", fields: [alterEgoId], references: [id])
  originalProfile User?  @relation("AlterEgo")
  onboardingStartedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// Existing tables ...

model GlobalConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ExerciseSet {
  id        String   @id @default(cuid())
  reps      Int
  exercise  String   // "PUSHUP", "PULLUP", "SQUAT"
  date      String   // YYYY-MM-DD
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([date, exercise])
}

model FineRecord {
  id        String   @id @default(cuid())
  amountEur Int      @default(2)
  date      String   // YYYY-MM-DD
  status    String   @default("unpaid") // "unpaid", "paid"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  paidAt    DateTime?

  @@unique([userId, date])
}

model MonthlyChallengeEntry {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD (Last day of month)
  type      String   @default("SALLY_UP")
  seconds   Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date, type])
}

model MedicalCertificate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDateISO    String
  endDateISO      String
  createdAt       DateTime @default(now())
  createdMonthKey String   // YYYY-MM (unique per user/month)
  note            String?

  @@unique([userId, createdMonthKey])
}

model PotEvent {
  id        String   @id @default(cuid())
  type      String   // "BUYOUT"
  amountEur Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())
}

model BadgeDefinition {
  key           String   @id
  name          String
  description   String
  isUnique      Boolean  @default(false)
  isTransferable Boolean @default(true)
  metricType    String   // "MAX_REPS", "BONUS_STREAK", "SERIES_COUNT", etc.
  exerciseScope String   // "PUSHUPS", "PULLUPS", "SQUATS", "ALL"
  threshold     Int?
  seriesTarget  Int?
  emoji         String   @default("🏅")
  ownership     BadgeOwnership?
  events        BadgeEvent[]
}

model BadgeOwnership {
  badgeKey      String   @id
  badge         BadgeDefinition @relation(fields: [badgeKey], references: [key], onDelete: Cascade)
  currentUserId String?
  currentUser   User?    @relation(fields: [currentUserId], references: [id], onDelete: SetNull)
  currentValue  Float    @default(0)
  achievedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  locked        Boolean  @default(false)
  likes         BadgeLike[]
}

model BadgeLike {
  id        String   @id @default(cuid())
  badgeKey  String
  badge     BadgeOwnership @relation(fields: [badgeKey], references: [badgeKey], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([badgeKey, userId])
}

model BadgeEvent {
  id            String   @id @default(cuid())
  badgeKey      String
  badge         BadgeDefinition @relation(fields: [badgeKey], references: [key], onDelete: Cascade)
  fromUserId    String?
  fromUser      User?    @relation("EventFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId      String?
  toUser        User?    @relation("EventTo", fields: [toUserId], references: [id], onDelete: SetNull)
  eventType     String   // "CLAIM", "STEAL", "UNIQUE_AWARDED"
  previousValue Float?
  newValue      Float?
  metadata      String?  // JSON string for additional info
  likes         BadgeEventLike[]
  createdAt     DateTime @default(now())
}

model BadgeEventLike {
  id        String   @id @default(cuid())
  eventId   String
  event     BadgeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model WallMessage {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model UserStatus {
  id        String   @id @default(cuid())
  content   String
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  likes     StatusLike[]
}

model StatusLike {
  id        String   @id @default(cuid())
  statusId  String
  status    UserStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([statusId, userId])
}


model XpAdjustment {
  id        String   @id @default(cuid())
  amount    Int
  reason    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([userId])
}

model SpecialWorkoutEntry {
  id              String   @id @default(cuid())
  workoutId       String   // ID from specialWorkouts.ts
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data            Json     // { exercises: { burpees: 50, run_m: 1000 }, time_sec: 450 }
  totalScore      Float?   // Calculated score for ranking if needed
  completionTime  Int?     // Seconds
  proofUrl        String?  // Optional link to photo/video proof
  date            String   // YYYY-MM-DD
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, workoutId])
  @@index([workoutId, totalScore])
}

// ─── SYSTÈME DE PARIS ────────────────────────────────────────────────────────────────────

model Bet {
  id               String      @id @default(cuid())
  type             String      // "PRONOSTIC" | "DUEL" | "COURSE"
  subType          String      @default("BINARY") // "BINARY" | "MULTI" | "NUMERIC" | "PLAYER_RACE"
  title            String
  description      String?
  options          String      // JSON : [{ key: string, label: string, emoji?: string }]
  status           String      @default("DRAFT") // "DRAFT" | "OPEN" | "LOCKED" | "RESOLVED" | "CANCELLED"
  openAt           DateTime?
  closeAt          DateTime?
  lockAt           DateTime?
  resolvedAt       DateTime?
  resolvedOption   String?
  resolvedByUserId String?
  createdByUserId  String
  createdBy        User        @relation("BetsCreated", fields: [createdByUserId], references: [id])
  targetUserId     String?
  targetUser       User?       @relation("BetsTargeted", fields: [targetUserId], references: [id])
  metadata         String?     // JSON extensible
  entries          BetEntry[]
  events           BetEvent[]
  result           BetResult?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([closeAt])
}

model BetEntry {
  id          String    @id @default(cuid())
  betId       String
  bet         Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  option      String
  xpStaked    Int
  multiplier  Float
  lockedOdd   Float?    // cote bookmaker figée au moment de la mise (null si pas de config stats)
  ecStaked    Int       @default(0)
  withdrawn   Boolean   @default(false)
  withdrawnAt DateTime?
  xpReturned  Int?
  ecReturned  Int?
  placedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([betId, userId])
  @@index([betId])
  @@index([userId])
}

model BetEvent {
  id         String         @id @default(cuid())
  betId      String
  bet        Bet            @relation(fields: [betId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  String         // "STAKE" | "INCREASE" | "WITHDRAW" | "RESOLVE" | "CANCEL" | "DUEL_SENT" | "DUEL_ACCEPTED" | "DUEL_DECLINED"
  xpAmount   Int            @default(0)
  ecAmount   Int            @default(0)
  option     String?
  multiplier Float?
  metadata   String?
  likes      BetEventLike[]
  createdAt  DateTime       @default(now())

  @@index([betId])
  @@index([userId])
  @@index([createdAt])
}

model BetEventLike {
  id        String   @id @default(cuid())
  eventId   String
  event     BetEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model BetResult {
  id                   String   @id @default(cuid())
  betId                String   @unique
  bet                  Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)
  winnerOption         String?
  resolvedAt           DateTime @default(now())
  resolvedByUserId     String
  distributionSnapshot String?  // JSON snapshot des gains distribués
  note                 String?
}

// ─── ÉCONOMIE EMBERCOINS ───────────────────────────────────────────────────────────────────

model CoinAdjustment {
  id        String   @id @default(cuid())
  amount    Int      // positif = gain, négatif = dépense
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String   // "BET_WIN" | "BET_STAKE" | "BET_WITHDRAW" | "BET_CANCELLED" | "BET_DECLINED" | "BADGE_REWARD" | "QUOTA_MODIFIER" | "SPECIAL_ACTION"
  refId     String?  // betId, badgeKey, etc.
  date      String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
}

// ─── MODIFICATEURS DE QUOTA ────────────────────────────────────────────────────────────────

model QuotaModifier {
  id               String   @id @default(cuid())
  type             String   // "REDUCE_SELF" | "INCREASE_OTHER"
  sourceUserId     String
  sourceUser       User     @relation("QuotaModifierSource", fields: [sourceUserId], references: [id])
  targetUserId     String
  targetUser       User     @relation("QuotaModifierTarget", fields: [targetUserId], references: [id])
  targetDateISO    String   // YYYY-MM-DD — jamais le jour de la dépense
  repsDelta        Int      // négatif pour REDUCE_SELF, positif pour INCREASE_OTHER
  ecCost           Int
  baseEcPerRep     Int      @default(10)
  demandMultiplier Float    @default(1.0)
  status           String   @default("PENDING") // "PENDING" | "APPLIED" | "CANCELLED"
  createdAt        DateTime @default(now())
  appliedAt        DateTime?

  @@index([targetUserId, targetDateISO])
  @@index([sourceUserId])
  @@index([targetDateISO, status])
}

model GamebookProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId     String
  currentNodeId String
  mood          String   @default("NEUTRE")
  mbtiScores    Json     @default("{}")
  temperaments  Json     @default("{}")
  flags         Json     @default("{}")
  history       Json     @default("[]")
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // === Champs ajoutés pour PushQuest v3 (carte Pokémon-style) ===
  mapId                String   @default("bourgpates")
  posX                 Int      @default(7)
  posY                 Int      @default(12)
  direction            String   @default("up")
  phase                String   @default("explore")
  introStep            Int      @default(0)
  hasEnteredTallGrass  Boolean  @default(false)
  monsterCaveRevealed  Boolean  @default(false)
  hasSeenWelcomeScreen Boolean  @default(false)
  lastSeen             DateTime @default(now())

  // === Champs ajoutés pour PushQuest v3.1 (Route 1 + Pont Pépite d'Azuria) ===
  treeObstacleCleared       Boolean @default(false)
  pioneerBadgeAwarded       Boolean @default(false)
  bridgePnjDefeated         Json    @default("[]")
  bridgePnjLastBeatenDate   Json    @default("{}")

  // === Champs ajoutés pour PushQuest v3.3 (PNJ de Bourg-Boulette) ===
  gymGuyEnergyGiven         Boolean @default(false)
  npcsTalkedTo              Json    @default("[]")

  // === Champs ajoutés pour PushQuest v3.4a (fix énergie persistante) ===
  energySpentToday          Int     @default(0)
  energySpentDate           String  @default("")

  // === Champs ajoutés pour PushQuest v3.6 (anti-triche suppression de reps) ===
  // null = pas frozen. Sinon, instant après lequel le joueur récupère ses mouvements Gamebook.
  gamebookFrozenUntil       DateTime?

  // === Champs ajoutés pour PushQuest v3.8 (Pépiteville + Inventaire) ===
  // Inventaire JSON. Format: Array<{ itemKey: string, quantity: number, data?: Record<string, unknown> }>
  inventory                 Json    @default("[]")
  // true une fois que PEPITO a offert le sac. Conditionne l'accès au shop + au menu START.
  hasBag                    Boolean @default(false)
  // true une fois que DURUM (gym_pepite) a donné ses 50 reps. Pendant idempotence-flag similaire à gymGuyEnergyGiven.
  durumEnergyGiven          Boolean @default(false)
  // v3.8.1 — fruits cueillis sur les arbres de Pépiteville (3/jour/arbre).
  // Format : { date: "YYYY-MM-DD", counts: { "apple_tree_1": 2, "apple_tree_2": 1 } }
  fruitsTaken               Json    @default("{}")
  // v3.8.2 — plus haut étage atteint dans la Tour des Pâtes Aiguës (1 = rez-de-chaussée, 5 = sommet).
  // Une fois un étage validé via le check squats, accès libre permanent (jusqu'à reset anti-cheat).
  towerFloorReached         Int     @default(1)
  // v3.11 — PIAFFINI sauvé : flag persistant à vie une fois donné. Débloque JOJO post-quête,
  // JOJETTE félicitations, et conditionnera l'accès à l'eau coopérative (v3.12).
  piaffiniRescued           Boolean @default(false)
  // v3.12 — première baignade faite : le joueur a été poussé dans l'eau au moins une fois,
  // il peut désormais traverser librement les cases waterShallow (avec coût de mouvement).
  // Sans ce flag, même avec swim_set, le joueur reste bloqué sur la berge ("trop froide").
  firstSwimDone             Boolean @default(false)

  // v3.14 — Tamagotchi adopté chez le vétérinaire de Macaron'île. JSON nullable.
  // Format : { name, adoptedAt, lastFedAt, happiness (0-100), feedCount, stage ("egg"|"baby"|"adult") }
  // null = pas encore adopté. Une fois adopté, l'objet n'est plus jamais effacé.
  tamagotchi                Json?

  // v3.17 — Chance accumulée en parlant à LINGUINI (1×/jour). Stocké en compteur.
  // Sera utilisé en v3.20 pour booster les odds du mini-jeu casino.
  luck                      Int     @default(0)
  // v3.17 — Date du dernier "tap" de LINGUINI (format YYYY-MM-DD). Vide = jamais parlé.
  lastLuckTalkDate          String  @default("")
  // v3.17c — Tableau "papa" récupéré dans la Tour (one-shot, +100 reps).
  papaBoostClaimed          Boolean @default(false)
  // v3.17c — Défi du Nageur (la_mer) : 50 pompes en une journée pour +100 reps. One-shot à vie.
  nageurDefiCompleted       Boolean @default(false)
  // v3.17c — Case cachée +50 reps du casino de Bourg-Boulette trouvée. One-shot.
  bourgCasinoCoinsFound     Boolean @default(false)

  // v3.19b — Bestioles des hautes herbes : true = première rencontre passée (pas de perte).
  // À false : la prochaine rencontre déclenche le modal nommage + premier "Aïe" sans perte.
  bestiolesFirstEncountered Boolean @default(false)
  // v3.19b — Nom donné à l'espèce de bestiole par le joueur (premier contact).
  bestiolesSpeciesName      String?

  // v3.21 — Mini-jeu casino roulette rouge/noir. Compteur de paris du jour (max 10/jour).
  casinoBetsDate            String  @default("")
  casinoBetsToday           Int     @default(0)

  // v3.22 — Villes débloquées pour le fast travel. Stocké en JSON array de mapIds.
  // Auto-ajout dès qu'on visite : bourgpates / pepiteville / hautespates / macaron_ile / muscuville.
  visitedTowns              Json    @default("[]")

  // v3.24a — Bonus quotidien du capitaine d'équipe. Format : YYYY-MM-DD du dernier claim.
  // Vide = jamais réclamé. Les joueurs sans équipe (Franss) ne peuvent pas claim.
  lastTeamCaptainBonusDate  String  @default("")

  // v3.24b — Casino pattern (Muscuville) : où en est le joueur dans le pattern de 20.
  // Le pattern est fixe (cf src/lib/gamebook/casino.ts CASINO_PATTERN). L'index s'incrémente
  // à chaque spin et boucle sur 20 (modulo). Reset après banqueroute (24h cooldown).
  casinoPatternSpinIndex    Int     @default(0)
  // Compteur de wins consécutifs (au moins 1 case gagnante sur le spin). Reset sur perte sèche.
  // 5 consécutifs → banqueroute + badge Casseur de banque + cooldown 24h.
  casinoPatternWinStreak    Int     @default(0)
  // Cooldown du casino après une banqueroute (24h). Null = casino ouvert.
  casinoPatternBankruptUntil DateTime?

  // v3.23c — Sommet du Mont Pasta-Ventoux atteint au moins une fois.
  // One-shot ; déclenche cinématique + badge Conquérant 500 XP. Aussi unlock contest_hall.
  montSummitReached         Boolean @default(false)

  // v3.24c-3 — Arc Team Boulette (Lasagnas Vegas).
  // pereTalked     : a parlé au Père Pesto et reçu le "mot de passe" (honest).
  // videurState    : état du dialogue videur — "untouched" | "honest_challenge" | "passed" | "lying_pursued" | "boss_beaten"
  // videurChallengeBaseline : reps au moment du défi 200/100/50 (snapshot pour calcul progression)
  // tbBarDefisDone : array des sbires bar (meowth/jessie/giovanni) déjà battus
  // tbBossKeyHeld  : true si JAMIE a donné la clé du boss
  // tbBossDefisDone: array des 4 défis boss (squat / pompes / hier / 2 jours) déjà validés
  // tbBossBeaten   : true si IL CAPO est vaincu (donne accès arène)
  pereTalked                Boolean @default(false)
  videurState               String  @default("untouched")
  videurChallengeBaseline   Int     @default(0)
  videurChallengeStartedAt  DateTime?
  tbBarDefisDone            Json    @default("[]")
  // v3.24c-6 — état actif des défis sbires (ex: { meowth: { baselinePushups, startedAt } }).
  tbBarChallengeData        Json    @default("{}")
  tbBossKeyHeld             Boolean @default(false)
  tbBossDefisDone           Json    @default("[]")
  tbBossBeaten              Boolean @default(false)
  // v3.24c-8 — IDs des brutes lâchées à qui le joueur a déjà parlé (1 malus de -10 reps par brute).
  tbBrutesTalked            Json    @default("[]")
  // v3.24c-9 — récompenses post-défaite IL CAPO : flag réclamation, reps bankés pour sérum, accès arène.
  tbRewardClaimed           Boolean @default(false)
  serumIntelligenceReps     Int     @default(0)
  arenaUnlocked             Boolean @default(false)
  // v3.25 — Pokédex des arbres : kinds découverts (apple/cherry/pear/peach/coconut/poison/olive/boost/divisor).
  treesDiscovered           Json    @default("[]")
  treeBookGiven             Boolean @default(false)
  // v3.27 — Animal follower : si true, l'animal est rangé dans le sac (pas affiché à l'écran).
  // tamagotchiInteractionsAt stocke les timestamps ISO des dernières interactions (sliding window 60s).
  tamagotchiInBag           Boolean @default(false)
  tamagotchiInteractionsAt  Json    @default("[]")
  // v3.28 — Cinématique des hautes herbes du sud (fin de l'arc Macaron'île).
  // Affichée une seule fois quand le joueur entre dans grass_sud avec son animal récupéré.
  grassSudCutsceneShown     Boolean @default(false)
  // v3.29 — Ornithologue (grass_sud) : bonus +50 énergies remis 1 fois si animal = oiseau.
  ornithologueBirdBonusGiven Boolean @default(false)
  // v3.24b — Jeux casino Vegas (limites par jour + states)
  // Lotto poule : 4x4 grid, 1/16, max 1 win/jour
  lottoPouleDate             String  @default("")
  lottoPouleWonToday         Boolean @default(false)
  // Stop ou encore : 3 essais/jour, mise 1-20, random crash
  stopOuEncoreDate           String  @default("")
  stopOuEncorePlaysToday     Int     @default(0)
  // Combats de coqs : 1×/jour à partir de 21h
  cockfightDate              String  @default("")
  // Slot machines : compteur quotidien (pas de cap dur, juste tracking)
  slotMachinesPlayedToday    Int     @default(0)
  slotMachinesDate           String  @default("")
  // Croupier boost/malus du jour (set au talk avec un croupier, applique au prochain pari)
  casinoBoostPctToday        Int     @default(0)
  casinoBoostDate            String  @default("")
  casinoCroupierTalkedToday  String  @default("")
  // Casino pattern Vegas (22 cases) : compteur séparé du Muscuville (casinoPatternSpinIndex)
  casinoPatternVegasIndex    Int     @default(0)
  casinoPatternVegasStreak   Int     @default(0)
  casinoPatternVegasBankruptUntil DateTime?
  // v3.24d — Stats animal (bonus permanents au-dessus du level XP : force, vitesse, défense, HP, intelligence).
  // Le bonheur reste dans tamagotchi.happiness (déjà existant).
  tamagotchiStatBonus        Json    @default("{}")
  // v3.24d — Compteur sérum d'intelligence consommé (par 1000 reps = +1 intelligence permanente).
  serumIntelligenceConsumed  Int     @default(0)
  // v3.24d — Date du dernier combat à l'arène (limite 1/jour).
  lastArenaDate              String  @default("")

  // v3.24a-4 — Mission jardinier BASILICO (Lasagnas Vegas).
  // jardinierMissionActive : true depuis qu'on a parlé à BASILICO la 1ère fois (= mission acceptée).
  // jardinierFruitOrder    : array JSON des tree.kind cueillis depuis le démarrage de la mission
  //                          (reset à chaque entrée chez le jardinier qui re-démarre la mission).
  // jardinierArrosoirGiven : true une fois que le jardinier a offert l'arrosoir (one-shot).
  jardinierMissionActive    Boolean @default(false)
  jardinierFruitOrder       Json    @default("[]")
  jardinierArrosoirGiven    Boolean @default(false)

  // v3.24a-2 — Hôtel Bellagiomato (Lasagnas Vegas) : dernière fois que le joueur a dormi.
  // Format YYYY-MM-DD. Permet 1 sommeil/jour. Reset à minuit.
  // Effet du sommeil :
  //   - energySpentToday → 0 (récupération totale du jour)
  //   - bonusSurplus non touché
  //   - gourde stored non touchée
  //   - tamagotchi happiness +30 + lastFedAt = now
  lastHotelSleepDate        String  @default("")

  // v3.23h — Level XP du joueur au moment où il est entré pour la PREMIÈRE fois chez V3T.
  // Cette valeur est snapshot et JAMAIS modifiée → garantit que l'animal du tamagotchi
  // reste celui correspondant à ce level (le joueur ne le voit pas évoluer même s'il level up
  // dans l'app). Null = jamais entré chez V3T.
  vetFirstVisitLevel        Int?

  // v3.23g — Nombre de fois où le joueur a tenté d'entrer dans l'eau avant son premier bain.
  // Sert à afficher des messages narratifs progressifs qui révèlent la mécanique du push
  // par un autre joueur. Reset jamais (sauf si on veut réécouter, ce qui n'est pas le cas).
  waterShallowAttempts      Int     @default(0)

  // v3.23f — Surplus de bonus persistant (jamais reset à minuit).
  // Format : positif uniquement. Représente les reps de bonus encore non dépensés.
  // Source de vérité pour l'énergie : availableEnergy = todayReps - energySpentToday + bonusSurplus
  // Quand un bonus est gagné (pommier, BUFFY, papa, capitaine, etc.) → bonusSurplus += reward
  // Quand de l'énergie est dépensée (mouvement, etc.) → consume bonusSurplus d'abord, puis energySpentToday
  // À minuit : energySpentToday est wipé mais bonusSurplus persiste. Plus de perte de surplus.
  bonusSurplus              Int     @default(0)
  // v3.23c-2 — Défis intersalle de Muscuville (contest_hall). Chacun one-shot +100 reps.
  contestDefiPompatorDone   Boolean @default(false)
  contestDefiSquatilusDone  Boolean @default(false)
  contestDefiTiroirDone     Boolean @default(false)

  // v3.23e — Blague unique pour Franss (cmpgu4uq5000069du4s19q5l9) suite au bug
  // PIAFFINI : PIAFFINI le téléporte une dernière fois à la Tour (gag), puis à
  // Bourg-Boulette chez JOJO + 30 reps cadeau. One-shot à vie, Franss only.
  franssJokeBirdDone        Boolean @default(false)

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([mapId])
  @@index([lastSeen(sort: Desc)])
}
